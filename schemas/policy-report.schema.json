{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polici.dev/schemas/policy-report.schema.json",
  "title": "Polici Policy Evaluation Result",
  "description": "JSON-serialized policy result. Result producers emit only finite numbers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "status", "exitCode", "policies", "diagnostics"],
  "properties": {
    "kind": { "const": "policy-evaluation" },
    "status": { "enum": ["passed", "failed", "error"] },
    "exitCode": { "enum": [0, 1, 2] },
    "policies": { "type": "array", "items": { "$ref": "#/$defs/policy" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
      "then": { "properties": { "exitCode": { "const": 0 } } }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
      "then": { "properties": { "exitCode": { "const": 1 } } }
    },
    {
      "if": { "properties": { "status": { "const": "error" } }, "required": ["status"] },
      "then": { "properties": { "exitCode": { "const": 2 } } }
    }
  ],
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "line", "column"],
      "properties": {
        "offset": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "line": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "column": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/position" },
        "end": { "$ref": "#/$defs/position" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string" },
        "pointer": { "type": "string", "pattern": "^(?:$|/)" },
        "span": { "$ref": "#/$defs/span" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message"],
      "properties": {
        "kind": {
          "enum": [
            "actual",
            "expected",
            "offending-item",
            "duplicate",
            "comparison",
            "check",
            "missing",
            "context"
          ]
        },
        "message": { "type": "string" },
        "value": { "$ref": "#/$defs/jsonValue" },
        "span": { "$ref": "#/$defs/span" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "span", "expressionSpan", "evidence"],
      "properties": {
        "status": { "enum": ["passed", "failed", "skipped", "error"] },
        "span": { "$ref": "#/$defs/span" },
        "expressionSpan": { "$ref": "#/$defs/span" },
        "message": { "type": "string" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "span", "requirements", "evidence"],
      "properties": {
        "name": { "type": "string" },
        "status": { "enum": ["passed", "failed", "skipped", "error"] },
        "span": { "$ref": "#/$defs/span" },
        "message": { "type": "string" },
        "requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/requirement" }
        },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "exitCode", "span", "rules"],
      "properties": {
        "name": { "type": "string" },
        "status": { "enum": ["passed", "failed", "error"] },
        "exitCode": { "enum": [0, 1, 2] },
        "span": { "$ref": "#/$defs/span" },
        "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
          "then": { "properties": { "exitCode": { "const": 0 } } }
        },
        {
          "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
          "then": { "properties": { "exitCode": { "const": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "error" } }, "required": ["status"] },
          "then": { "properties": { "exitCode": { "const": 2 } } }
        }
      ]
    },
    "related": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "span"],
      "properties": {
        "message": { "type": "string" },
        "span": { "$ref": "#/$defs/span" }
      }
    },
    "jsonValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "severity", "source", "span"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "severity": { "enum": ["error", "warning", "information"] },
        "source": {
          "enum": [
            "lexer",
            "parser",
            "binder",
            "type",
            "provider",
            "permission",
            "runtime",
            "evaluator"
          ]
        },
        "span": { "$ref": "#/$defs/span" },
        "related": { "type": "array", "items": { "$ref": "#/$defs/related" } }
      }
    }
  }
}
