{
  "contractMajor": 1,
  "documentation": { "summary": "Example static provider contract." },
  "exports": {
    "health": {
      "kind": "resource",
      "resolve": "health",
      "type": { "kind": "core", "type": "Check" }
    },
    "user": {
      "kind": "function",
      "parameters": [{ "name": "login", "type": { "kind": "string" } }],
      "resolve": "user",
      "returns": { "kind": "ref", "type": "User" }
    }
  },
  "name": "example",
  "permissions": ["example:users:read"],
  "policiApi": 1,
  "runtime": {
    "capabilities": ["example:users:read"],
    "entrypoint": "./runtime",
    "kind": "typescript",
    "protocol": 1,
    "transport": "jsonl"
  },
  "schema": "polici.plugin/v2",
  "schemaVersion": 2,
  "types": {
    "User": {
      "fields": {
        "groups": { "items": { "kind": "string" }, "kind": "set", "resolve": "user.groups" },
        "id": { "kind": "id", "namespace": "example:user" },
        "login": { "kind": "string" }
      },
      "identity": "id",
      "kind": "entity"
    }
  },
  "version": "1.0.0"
}
